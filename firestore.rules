rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidSettings(data) {
      return data.adminName is string && data.adminName.size() <= 100
        && (data.get('logoUrl', '') is string)
        && (data.get('businessAddress', '') is string)
        && (data.get('email', '') is string)
        && data.keys().hasAll(['adminName']);
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() <= 100
        && (data.get('email', '') is string)
        && data.keys().hasAll(['name']);
    }

    function isValidInvoice(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() <= 50
        && data.customerId is string
        && data.items is list
        && data.items.size() > 0
        && data.total is number;
    }

    // --- Matches ---
    match /settings/business {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidSettings(incoming());
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidCustomer(incoming());
      allow delete: if isSignedIn();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(invoiceId) && isValidInvoice(incoming());
      allow update: if isSignedIn() && isValidInvoice(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'total', 'subtotal', 'tax'])
      );
      allow delete: if isSignedIn();
    }
  }
}
