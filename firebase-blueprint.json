{
  "entities": {
    "Settings": {
      "title": "Business Settings",
      "description": "Store admin name, logo, and business contact information.",
      "type": "object",
      "properties": {
        "adminName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "businessAddress": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "currency": { "type": "string" }
      },
      "required": ["adminName"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "E-commerce invoice details.",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "paid", "cancelled"] }
      },
      "required": ["invoiceNumber", "customerId", "items", "total"]
    }
  },
  "firestore": {
    "/settings/business": {
      "schema": "Settings",
      "description": "Singleton document for business configuration."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of customers."
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of invoices."
    }
  }
}
